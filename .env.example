# ORDIS Environment Configuration Template (.env.example)
# Copy this file to .env before starting containers: cp .env.example .env

# Application & Operational Deployment Profile
APP_NAME="ORDIS Cephalon AI"
ENVIRONMENT=local                          # local or cloud
DEPLOYMENT_MODE=local-standalone           # local-standalone (Profile A) or cloud-enterprise (Profile B)

# Ollama Local LLM Configurations (Self-Hosted Node)
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=gemma2:2b
EMBEDDING_MODEL=nomic-embed-text

# Optional Gemini Cloud API (Auto-failover when OLLAMA is unreachable)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# LLM Generation Parameters
LLM_TEMPERATURE=0.3
LLM_REPEAT_PENALTY=1.18
LLM_REPEAT_LAST_N=64
LLM_TOP_P=0.9
LLM_NUM_PREDICT=400

# Storage Tiers & Microservices
CHROMA_HOST=http://chromadb:8000
CHROMA_PORT=8000
COLLECTION_NAME=ordis_knowledge
MCP_SERVERS_URL=http://mcp-servers:8001

# Subsystem Adapters & Telemetry
VECTOR_STORE_PROVIDER=chroma              # chroma, qdrant, or vertex
LLM_PROVIDER=ollama                       # ollama, gemini, or auto
TELEMETRY_PROVIDER=local                 # local or gcp
ENABLE_GCP_TELEMETRY=false

# Billing Killswitch & Cost Guardrails
COOLDOWN_SECONDS=10
PROMPT_CHARACTER_LIMIT=250
MAX_DAILY_QUERIES=300
CACHE_SIMILARITY_THRESHOLD=0.92

# OAuth Security Secrets
OAUTH_SECRET_KEY=change_this_to_your_secure_random_secret_key

# Streamlit Frontend Settings
BACKEND_URL=http://backend:8000
BACKEND_API_URL=http://backend:8000

